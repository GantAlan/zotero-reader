{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GantAlan/zotero-reader/blob/main/assets/package-template/schemas/reading-note.schema.json",
  "title": "Zotero Reader structured reading note",
  "type": "object",
  "required": [
    "schemaVersion",
    "itemKey",
    "attachmentKey",
    "title",
    "generatedAt",
    "noteFile",
    "chunks",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "itemKey": {
      "type": "string",
      "minLength": 1
    },
    "attachmentKey": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "noteFile": {
      "type": "string",
      "minLength": 1
    },
    "collectionKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "collectionPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunkId",
          "section",
          "pageStart",
          "pageEnd",
          "summary"
        ],
        "properties": {
          "chunkId": {
            "type": "string",
            "minLength": 1
          },
          "pageStart": {
            "type": "integer",
            "minimum": 1
          },
          "pageEnd": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidenceId",
          "claim",
          "section",
          "chunkIds",
          "pageStart",
          "pageEnd"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string"
          },
          "chunkIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "pageStart": {
            "type": "integer",
            "minimum": 1
          },
          "pageEnd": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}
